{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with strict warnings",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RIVA_BUILD_TESTS": "ON",
        "RIVA_BUILD_CLI": "ON",
        "RIVA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with strict warnings",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RIVA_BUILD_TESTS": "ON",
        "RIVA_BUILD_CLI": "ON",
        "RIVA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Debug with ASan and UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "RIVA_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release", "configuration": "Release"},
    {"name": "debug", "configurePreset": "debug", "configuration": "Debug"},
    {"name": "sanitizers", "configurePreset": "sanitizers", "configuration": "Debug"}
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "configuration": "Debug",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {"outputOnFailure": true}
    }
  ]
}
